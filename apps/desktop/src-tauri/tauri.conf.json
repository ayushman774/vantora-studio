{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vantora Studio",
  "version": "0.3.0",
  "identifier": "com.vantora.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vantora Studio",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "backgroundColor": "#090d15"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
